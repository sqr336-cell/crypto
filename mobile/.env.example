# Copy to .env and fill in to connect a Supabase project.
# Leave empty to run BEATLINK in demo mode (no backend, fictional profiles).
# These two values are public by design (protected by Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional
EXPO_PUBLIC_FORCE_DEMO=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
