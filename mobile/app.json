{
  "expo": {
    "name": "BEATLINK",
    "slug": "beatlink",
    "scheme": "beatlink",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0D12",
    "ios": {
      "bundleIdentifier": "app.beatlink.mobile",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "BEATLINK uses your photos to set your profile picture and cover image."
      }
    },
    "android": {
      "package": "app.beatlink.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0E0D12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "BEATLINK",
      "themeColor": "#0E0D12",
      "backgroundColor": "#0E0D12"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BEATLINK uses your photos to set your profile picture and cover image.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A99BFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0D12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
